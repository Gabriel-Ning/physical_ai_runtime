<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isaacteleop_toolbox</name>
  <version>0.1.0</version>
  <description>ROS 2 teleoperation source framework built on IsaacTeleop.</description>
  <maintainer email="guomning@gmail.com">Gabriel-Ning</maintainer>
  <author email="guomning@gmail.com">Gabriel-Ning</author>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/Gabriel-Ning/isaacteleop_toolbox</url>
  <url type="bugtracker">https://github.com/Gabriel-Ning/isaacteleop_toolbox/issues</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
