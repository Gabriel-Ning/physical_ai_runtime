<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>joint_trajectory_controller_guard</name>
  <version>0.1.0</version>
  <description>RT-host liveness guard that cancels active JTC goals when workstation supervision is lost.</description>
  <maintainer email="42087775+Gabriel-Ning@users.noreply.github.com">Ning Guo</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/Gabriel-Ning/phy_ai_runtime_controllers</url>
  <url type="repository">https://github.com/Gabriel-Ning/phy_ai_runtime_controllers.git</url>
  <url type="bugtracker">https://github.com/Gabriel-Ning/phy_ai_runtime_controllers/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>action_msgs</depend>
  <depend>control_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>controller_manager</test_depend>
  <test_depend>joint_trajectory_controller</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>mock_components</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>robot_state_publisher</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
