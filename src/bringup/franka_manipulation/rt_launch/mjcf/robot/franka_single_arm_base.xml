<mujoco model="franka_single_arm_base">
  <option integrator="implicitfast" timestep="0.001"/>
  <asset>
    <!-- Premium Realistic Franka FR3 & Pika Gripper Materials -->
    <material name="fr3_white" rgba="0.94 0.94 0.96 1" specular="0.6" shininess="0.5"/>
    <material name="fr3_joint_black" rgba="0.14 0.14 0.16 1" specular="0.4" shininess="0.4"/>
    <material name="fr3_metal_grey" rgba="0.45 0.45 0.48 1" specular="0.8" shininess="0.7"/>
    <material name="fr3_accent_blue" rgba="0.08 0.45 0.85 1" specular="0.6" shininess="0.5"/>

    <!-- Pika Gripper Materials -->
    <material name="pika_adaptor_mat" rgba="0.20 0.20 0.22 1" specular="0.7" shininess="0.6"/>
    <material name="pika_chassis_white" rgba="0.95 0.95 0.97 1" specular="0.5" shininess="0.5"/>
    <material name="pika_glass_black" rgba="0.08 0.08 0.10 1" specular="0.9" shininess="0.9"/>
    <material name="pika_camera_lens" rgba="0.15 0.55 0.95 1" specular="0.9" shininess="0.9"/>
    <material name="pika_finray_blue" rgba="0.15 0.48 0.78 1" specular="0.4" shininess="0.3"/>
    <material name="pika_grip_pad" rgba="0.22 0.24 0.26 1" specular="0.2" shininess="0.1"/>

    <!-- Franka FR3 Arm meshes (from franka_description) -->
    <mesh name="fr3_link0" file="../../../../franka_description/share/franka_description/meshes/robots/fr3/collision/link0.stl"/>
    <mesh name="fr3_link1" file="../../../../franka_description/share/franka_description/meshes/robots/fr3/collision/link1.stl"/>
    <mesh name="fr3_link2" file="../../../../franka_description/share/franka_description/meshes/robots/fr3/collision/link2.stl"/>
    <mesh name="fr3_link3" file="../../../../franka_description/share/franka_description/meshes/robots/fr3/collision/link3.stl"/>
    <mesh name="fr3_link4" file="../../../../franka_description/share/franka_description/meshes/robots/fr3/collision/link4.stl"/>
    <mesh name="fr3_link5" file="../../../../franka_description/share/franka_description/meshes/robots/fr3/collision/link5.stl"/>
    <mesh name="fr3_link6" file="../../../../franka_description/share/franka_description/meshes/robots/fr3/collision/link6.stl"/>
    <mesh name="fr3_link7" file="../../../../franka_description/share/franka_description/meshes/robots/fr3/collision/link7.stl"/>

    <!-- Pika Gripper meshes (from pika_gripper_description) -->
    <mesh name="pika_franka_adaptor" file="../../../../pika_gripper_description/share/pika_gripper_description/meshes/pika_adaptor/pika_franka_adaptor.STL"/>
    <mesh name="pika_gripper_base" file="../../../../pika_gripper_description/share/pika_gripper_description/meshes/gripper_base_link.STL"/>
    <mesh name="pika_finray_finger" file="../../../../pika_gripper_description/share/pika_gripper_description/meshes/pika_finray_link.STL"/>
  </asset>

  <default>
    <default class="fr3_arm">
      <joint damping="1.0" armature="0.1" frictionloss="0.1"/>
      <geom type="mesh" material="fr3_white" contype="1" conaffinity="1"/>
      <position kp="800" kv="40" forcerange="-87 87"/>
    </default>
    <default class="fr3_wrist">
      <joint damping="0.5" armature="0.05" frictionloss="0.05"/>
      <geom type="mesh" material="fr3_white" contype="1" conaffinity="1"/>
      <position kp="300" kv="20" forcerange="-12 12"/>
    </default>
    <default class="pika_gripper">
      <joint frictionloss="0.01" damping="0.1" type="slide"/>
      <geom type="mesh" material="pika_finray_blue" contype="1" conaffinity="1" condim="4"
            friction="4.0 0.1 0.01" solref="0.004 1" solimp="0.95 0.99 0.001"/>
      <position forcerange="-200 200" kp="2000" kv="80"/>
    </default>
  </default>

  <worldbody>
    <!-- Franka FR3 7-DOF Robotic Arm (Mounted on Tabletop at Z=0.72) -->
    <body name="fr3_link0" pos="0.0 -0.20 0.72">
      <inertial pos="-0.0172 0.0004 0.0745" mass="2.3966" fullinertia="0.009000 0.011500 0.008500 0.000000 0.002000 0.000000"/>
      <geom mesh="fr3_link0" class="fr3_arm" material="fr3_white"/>

      <body name="fr3_link1" pos="0 0 0.333">
        <inertial pos="0.0000004 -0.018125 -0.038604" mass="2.927465" fullinertia="0.023927 0.022482 0.006350 0.000013 -0.000114 -0.001995"/>
        <joint name="fr3_joint1" axis="0 0 1" range="-2.9007 2.9007" class="fr3_arm"/>
        <geom mesh="fr3_link1" class="fr3_arm" material="fr3_white"/>

        <body name="fr3_link2" pos="0 0 0" quat="0.7071068 -0.7071068 0 0">
          <inertial pos="0.003183 -0.074322 0.008815" mass="2.935537" fullinertia="0.041939 0.025145 0.061702 0.000203 0.004078 -0.004225"/>
          <joint name="fr3_joint2" axis="0 0 1" range="-1.8361 1.8361" class="fr3_arm"/>
          <geom mesh="fr3_link2" class="fr3_arm" material="fr3_white"/>

          <body name="fr3_link3" pos="0 -0.316 0" quat="0.7071068 0.7071068 0 0">
            <inertial pos="0.040702 -0.004820 -0.028973" mass="2.244901" fullinertia="0.024101 0.019741 0.019044 0.002405 -0.002856 -0.002104"/>
            <joint name="fr3_joint3" axis="0 0 1" range="-2.9007 2.9007" class="fr3_arm"/>
            <geom mesh="fr3_link3" class="fr3_arm" material="fr3_white"/>

            <body name="fr3_link4" pos="0.0825 0 0" quat="0.7071068 0.7071068 0 0">
              <inertial pos="-0.045910 0.063049 -0.008519" mass="2.615596" fullinertia="0.034530 0.028882 0.041255 0.013226 0.010151 -0.000976"/>
              <joint name="fr3_joint4" axis="0 0 1" range="-3.0770 -0.1169" class="fr3_arm"/>
              <geom mesh="fr3_link4" class="fr3_arm" material="fr3_white"/>

              <body name="fr3_link5" pos="-0.0825 0.384 0" quat="0.7071068 -0.7071068 0 0">
                <inertial pos="-0.001604 0.029254 -0.097297" mass="2.327121" fullinertia="0.051610 0.047877 0.016424 -0.005715 -0.003567 0.010674"/>
                <joint name="fr3_joint5" axis="0 0 1" range="-2.8763 2.8763" class="fr3_wrist"/>
                <geom mesh="fr3_link5" class="fr3_wrist" material="fr3_white"/>

                <body name="fr3_link6" pos="0 0 0" quat="0.7071068 0.7071068 0 0">
                  <inertial pos="0.059713 -0.041029 -0.010169" mass="1.817038" fullinertia="0.005412 0.014058 0.016081 0.006193 0.001422 -0.001314"/>
                  <joint name="fr3_joint6" axis="0 0 1" range="0.4398 4.6216" class="fr3_wrist"/>
                  <geom mesh="fr3_link6" class="fr3_wrist" material="fr3_white"/>

                  <body name="fr3_link7" pos="0.088 0 0" quat="0.7071068 0.7071068 0 0">
                    <inertial pos="0.004523 0.008626 -0.016163" mass="0.627143" diaginertia="0.000211 0.000177 0.000060"/>
                    <joint name="fr3_joint7" axis="0 0 1" range="-3.0508 3.0508" class="fr3_wrist"/>
                    <geom mesh="fr3_link7" class="fr3_wrist" material="fr3_white"/>

                    <!-- Link8 Flange Mounting Point -->
                    <body name="fr3_link8" pos="0 0 0.107">
                      <site name="fr3_flange" pos="0 0 0" quat="1 0 0 0"/>

                      <!-- Pika Adaptor Mount (yaw = 3*pi/4 = 135 deg) -->
                      <body name="pika_adaptor_link" pos="0 0 0" euler="0 0 2.3561945">
                        <inertial pos="-0.01065 0.00003 0.00338" mass="0.05" diaginertia="1.304e-05 3.212e-05 4.432e-05"/>
                        <geom type="mesh" mesh="pika_franka_adaptor" material="pika_adaptor_mat" contype="1" conaffinity="1"/>

                        <!-- Pika Gripper Base (mount xyz="0 0 0.004", yaw = -pi/2 = -90 deg) -->
                        <body name="gripper_base_link" pos="0 0 0.004" euler="0 0 -1.5707963">
                          <inertial pos="-0.0000008 0.0084 0.0375" mass="0.1897" diaginertia="0.00014 0.00011 0.00022"/>
                          <geom type="mesh" mesh="pika_gripper_base" material="pika_chassis_white" contype="1" conaffinity="1"/>

                          <!-- Pika TCP Tracking Site (matches gripper_tcp.yaml at z=0.21) -->
                          <site name="pika_gripper_tcp" pos="0 0 0.21" quat="1 0 0 0"/>

                          <!-- Pika Wrist Camera Optical Frame -->
                          <site name="pika_wrist_color_optical_frame" pos="0.04 0.03 0.08" quat="0.5 -0.5 0.5 -0.5"/>

                          <!-- Pika Wrist Camera (D405 / eye-in-hand) -->
                          <camera name="pika_d405" pos="0.02 0.05 0.05" euler="0 3.1415926 0" fovy="58" resolution="640 480"/>
                          <camera name="wrist_camera" pos="0.02 0 0.05" euler="0 3.1415926 0" fovy="58" resolution="640 480"/>
                          <camera name="robot0_eye_in_hand" pos="0.02 0 0.05" euler="0 3.1415926 0" fovy="58" resolution="640 480"/>

                          <!-- Left Finger: origin at xyz="0.03898 0 0.0815", touching center at q=0 -->
                          <body name="gripper_left_link" pos="0.03898 0 0.0815">
                            <inertial pos="-0.0147 -0.0058 0.0333" mass="0.0337" diaginertia="0.00003 0.00004 0.00002"/>
                            <joint name="gripper_left_joint" type="slide" axis="1 0 0" range="0.0 0.045" class="pika_gripper"/>
                            <geom type="mesh" mesh="pika_finray_finger" class="pika_gripper"/>
                          </body>

                          <!-- Right Finger: origin at xyz="-0.03898 0 0.0815", touching center at q=0 -->
                          <body name="gripper_right_link" pos="-0.03898 0 0.0815" euler="0 0 -3.14159265">
                            <inertial pos="0.0147 -0.0058 0.0333" mass="0.0337" diaginertia="0.00003 0.00004 0.00002"/>
                            <joint name="gripper_right_joint" type="slide" axis="1 0 0" range="0.0 0.045" class="pika_gripper"/>
                            <geom type="mesh" mesh="pika_finray_finger" class="pika_gripper"/>
                          </body>

                        </body>
                      </body>
                    </body>

                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="fr3_link0" body2="fr3_link1"/>
    <exclude body1="fr3_link1" body2="fr3_link2"/>
    <exclude body1="fr3_link2" body2="fr3_link3"/>
    <exclude body1="fr3_link3" body2="fr3_link4"/>
    <exclude body1="fr3_link4" body2="fr3_link5"/>
    <exclude body1="fr3_link5" body2="fr3_link6"/>
    <exclude body1="fr3_link6" body2="fr3_link7"/>
    <exclude body1="fr3_link7" body2="pika_adaptor_link"/>
    <exclude body1="pika_adaptor_link" body2="gripper_base_link"/>
    <exclude body1="gripper_base_link" body2="gripper_left_link"/>
    <exclude body1="gripper_base_link" body2="gripper_right_link"/>
    <exclude body1="gripper_left_link" body2="gripper_right_link"/>
  </contact>
</mujoco>
