# Pika UVC Fisheye camera (Sunplus DECXIN 1bcf:2cd1).
#
# NOTE: Site-specific for Marvin gamma RT host (192.168.1.102), pinned by USB
# port topology. Re-enumerate after rewiring and update KERNELS=… together with
# marvin config/camera/marvin_cameras.yaml (and gripper ttyUSB defaults).
#
# Current gamma map (re-verified 2026-08-20 after replug):
#   left  -> /dev/fisheye0  (USB 3-9.1, same hub as left gripper ttyUSB1)
#   right -> /dev/fisheye1  (USB 3-7.1, same hub as right gripper ttyUSB0)
KERNEL=="video[0-9]*", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="1bcf", ATTRS{idProduct}=="2cd1", ATTR{index}=="0", KERNELS=="3-9.1", SYMLINK+="fisheye0", MODE="0666"
KERNEL=="video[0-9]*", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="1bcf", ATTRS{idProduct}=="2cd1", ATTR{index}=="0", KERNELS=="3-7.1", SYMLINK+="fisheye1", MODE="0666"

# Single-camera setup (e.g. FR3 + one Pika): uncomment and comment the rules above.
# KERNEL=="video[0-9]*", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="1bcf", ATTRS{idProduct}=="2cd1", ATTR{index}=="0", SYMLINK+="fisheye0", MODE="0666"
