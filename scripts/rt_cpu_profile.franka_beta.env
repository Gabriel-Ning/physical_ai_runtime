# Realtime CPU isolation profile — Franka RT host (beta).
# Sourced by setup_cpu_rt_host.sh / apply_rt_isolcpus.sh / .envrc (cpu env)
# and controller bringup (taskset for ros2_control_node).
#
# Layout (16 logical CPUs):
#   0-11   general OS / DDS / cameras / ROS NIC IRQs
#   12-13  isolated — Franka NIC (enp2s0) hard IRQs + softirq
#   14-15  isolated — ros2_control / libfranka 1 kHz loop
#
# Apply:
#   sudo bash scripts/apply_franka_rt_networking.sh --install
#   sudo bash scripts/apply_rt_isolcpus.sh --apply --replace
#   sudo reboot

RT_ISOL_CPUS=12-15
RT_CM_CPU_AFFINITY=14,15
RT_CPU_PROFILE_NAME=franka_single_isol4

# Franka FCI NIC (direct cable). Keep ROS/DDS off this interface.
RT_FRANKA_NIC=enp2s0
RT_FRANKA_IRQ_CPUS=12,13

# Workstation / CycloneDDS NIC — IRQs must stay off isolated CPUs.
RT_ROS_NIC=enp90s0
RT_ROS_IRQ_CPUS=0-11
