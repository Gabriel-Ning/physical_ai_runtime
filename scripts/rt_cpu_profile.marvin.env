# Marvin RT host — same NUC11 i9-11900KB class as Piper.
# HT pairs: (0,8) (1,9) (2,10) (3,11) (4,12) (5,13) (6,14) (7,15)
#
# Isolate physical cores 4-7 as whole pairs. Dual-arm 500 Hz + Pika
# share ros2_control; do not split a core across OS and CM.
#
#   pixi run setup-rt marvin

RT_ISOL_CPUS=4-7,12-15
RT_CM_CPU_AFFINITY=4-7,12-15
RT_CPU_PROFILE_NAME=marvin_pika_isol8
