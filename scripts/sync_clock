#!/usr/bin/env bash
# Align workstation and RT-host wall clocks (ROS header.stamp / evaluate(now)).
#
# host terminal:
#   scripts/sync_clock --setup  rt_user@rt_ip
#   scripts/sync_clock --status rt_user@rt_ip
#
# ssh rt host terminal (after: ssh rt_user@rt_ip):
#   sudo scripts/sync_clock --ip <workstation_lan_ip> --follow
#
# Target: chrony |offset| <= 100 us. SSH date skew is noisier — ignore it.
set -euo pipefail

DEFAULT_HOST="delta@192.168.1.101"
WAIT_S="${SYNC_CLOCK_WAIT_S:-120}"
SCRIPT_PATH="$(readlink -f "$0")"

MODE=""
VALUE=""
FOLLOW=0
ONESHOT=0
HOST=""
LOCAL_IP=""

usage() {
  sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status|--apply|--setup|--serve)
      MODE="${1#--}"
      shift
      ;;
    --ip)
      MODE=ip
      VALUE="${2:-}"
      shift 2
      ;;
    --utc)
      MODE=utc
      VALUE="${2:-}"
      shift 2
      ;;
    --follow)
      FOLLOW=1
      shift
      ;;
    --oneshot)
      ONESHOT=1
      shift
      ;;
    --local-ip)
      LOCAL_IP="${2:-}"
      shift 2
      ;;
    -h|--help) usage 0 ;;
    -*)
      echo "Unknown option: $1" >&2
      usage 1
      ;;
    *)
      if [[ -n "$HOST" ]]; then
        echo "Unexpected argument: $1" >&2
        usage 1
      fi
      HOST="$1"
      shift
      ;;
  esac
done

if [[ -z "$MODE" ]]; then
  echo "On the workstation after joining the robot LAN: scripts/sync_clock --setup" >&2
  usage 1
fi

ssh_base() {
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST" "$@"
}

ssh_tty() {
  ssh -tt -o ConnectTimeout=15 "$HOST" "$@"
}

remote_ipv4() {
  local spec="$1"
  spec="${spec##*@}"
  spec="${spec%%:*}"
  printf '%s\n' "$spec"
}

detect_local_ip() {
  local peer="$1"
  if [[ -n "$LOCAL_IP" ]]; then
    printf '%s\n' "$LOCAL_IP"
    return
  fi
  ip -4 route get "$peer" 2>/dev/null \
    | awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }'
}

measure_skew_ms() {
  # Positive => remote ahead of local. Corrects for half RTT.
  python3 - "$HOST" <<'PY'
import subprocess, sys, time
host = sys.argv[1]
samples = []
for _ in range(5):
    t0 = time.time()
    out = subprocess.check_output(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host, "date -u +%s.%N"],
        text=True,
    ).strip()
    t1 = time.time()
    remote = float(out)
    mid = 0.5 * (t0 + t1)
    samples.append(((remote - mid) * 1000.0, (t1 - t0) * 1000.0))
samples.sort(key=lambda x: x[0])
skew = samples[len(samples) // 2][0]
rtt = sum(s[1] for s in samples) / len(samples)
print(f"{skew:.1f} {rtt:.1f}")
PY
}

print_verdict() {
  # Prefer chrony offset (ms). SSH date skew is a noisy cross-check.
  local offset_ms="$1"
  local abs
  abs="$(awk -v s="$offset_ms" 'BEGIN { printf "%.3f", sqrt(s * s) }')"
  local us
  us="$(awk -v a="$abs" 'BEGIN { printf "%.0f", a * 1000.0 }')"
  if awk -v a="$abs" 'BEGIN { exit !(a <= 0.1) }'; then
    echo "verdict:           GOOD      (|offset| ${us} us <= 100 us)"
  elif awk -v a="$abs" 'BEGIN { exit !(a <= 0.5) }'; then
    echo "verdict:           OK        (|offset| ${us} us <= 500 us)"
  elif awk -v a="$abs" 'BEGIN { exit !(a <= 2) }'; then
    echo "verdict:           MARGINAL  (|offset| ${abs} ms <= 2 ms)"
  else
    echo "verdict:           HIGH      (|offset| ${abs} ms) — on workstation: scripts/sync_clock --setup rt_user@rt_ip"
  fi
}

remote_chrony_offset_ms() {
  ssh_base 'chronyc tracking 2>/dev/null' | awk -F': ' '
    /Reference ID/ { ref = $2 }
    /System time/ {
      split($2, a, " ")
      ms = a[1] * 1000.0
      if ($2 ~ /slow/) ms = -ms
      have_offset = 1
    }
    /Leap status/ { leap = $2 }
    END {
      if (have_offset && leap == "Normal" && ref !~ /^00000000/) {
        printf "%.2f", ms
      }
    }'
}

print_status() {
  local skew rtt chrono
  HOST="${HOST:-$DEFAULT_HOST}"
  read -r skew rtt < <(measure_skew_ms)
  chrono="$(remote_chrony_offset_ms || true)"
  echo "host:              $HOST"
  echo "local UTC:         $(date -u +'%Y-%m-%d %H:%M:%S.%N %Z')"
  echo "remote UTC:        $(ssh_base "date -u +'%Y-%m-%d %H:%M:%S.%N %Z'")"
  echo "ssh-date skew:     ${skew} ms  (RTT ${rtt} ms, noisy)"
  if [[ -n "${chrono}" ]]; then
    echo "chrony offset:     ${chrono} ms  ($(awk -v c="$chrono" 'BEGIN { printf "%.0f", sqrt(c * c) * 1000 }') us, RT vs NTP peer)"
    print_verdict "$chrono"
  else
    echo "chrony offset:     (remote chrony is unavailable or not synchronized)"
    echo "verdict:           NOT_SYNC  (wait for Leap status: Normal and a real Reference ID)"
  fi
  ssh_base 'timedatectl 2>/dev/null | sed -n "1,8p"; echo; chronyc tracking 2>/dev/null | sed -n "1,8p"' || true
}

ntp_is_serving() {
  ss -ulnp 2>/dev/null | grep -q ':123'
}

lan_cidr_from_ip() {
  local ip="$1"
  printf '%s.0/24\n' "${ip%.*}"
}

serve_lan() {
  local ip cidr conf
  ip="${LOCAL_IP:-}"
  if [[ -z "$ip" ]]; then
    echo "--serve needs --local-ip A.B.C.D (or run --setup, which detects it)." >&2
    exit 1
  fi
  if [[ "$(id -u)" -ne 0 ]]; then
    echo "Re-exec --serve with sudo ..."
    exec sudo -- "$SCRIPT_PATH" --serve --local-ip "$ip"
  fi
  cidr="$(lan_cidr_from_ip "$ip")"
  conf="/etc/chrony/conf.d/pai-lan.conf"
  mkdir -p /etc/chrony/conf.d
  cat >"$conf" <<EOF
# Managed by scripts/sync_clock --serve
allow ${cidr}
local stratum 10
EOF
  echo "Wrote ${conf} (allow ${cidr}, local stratum 10)"
  timedatectl set-ntp true || true
  systemctl enable --now chrony
  systemctl restart chrony
  sleep 0.5
  if ss -ulnp 2>/dev/null | grep -q ':123'; then
    echo "chronyd is listening on UDP/123"
  else
    echo "WARNING: chronyd is not listening on UDP/123" >&2
  fi
  timedatectl | sed -n '1,8p' || true
}

ensure_lan_ntp() {
  local ws_ip="$1"
  if ntp_is_serving; then
    echo "Workstation NTP:   already listening on UDP/123"
    return
  fi
  echo "Workstation NTP:   enabling LAN serve for $(lan_cidr_from_ip "$ws_ip")"
  sudo -- "$SCRIPT_PATH" --serve --local-ip "$ws_ip"
}

apply_remote() {
  HOST="${HOST:-$DEFAULT_HOST}"
  local peer ws_ip skew_before skew_after rtt remote_args remote_tmp
  peer="$(remote_ipv4 "$HOST")"
  ws_ip="$(detect_local_ip "$peer")"
  if [[ -z "$ws_ip" ]]; then
    echo "Could not detect the LAN IP this host uses toward ${peer}." >&2
    echo "Pass it explicitly: --local-ip 192.168.1.18" >&2
    exit 1
  fi

  read -r skew_before rtt < <(measure_skew_ms)
  echo "Before: ssh-date skew ${skew_before} ms (RTT ${rtt} ms)"
  echo "NTP peer the RT host will follow: ${ws_ip}"
  ensure_lan_ntp "$ws_ip"

  remote_args=(--ip "$ws_ip")
  if [[ "$ONESHOT" -ne 1 ]]; then
    remote_args+=(--follow)
  fi

  echo
  echo "Step 1/2: copy script to $HOST."

  # Do not pipe the script on the same stdin as sudo. A later `sudo -n` SSH
  # cannot reuse the timestamp from `sudo -v` (new TTY / tty_tickets).
  remote_tmp="$(
    ssh -o ConnectTimeout=15 "$HOST" \
      'tmp=$(mktemp) && cat >"$tmp" && printf %s "$tmp"' \
      <"$SCRIPT_PATH"
  )"
  if [[ -z "$remote_tmp" ]]; then
    echo "Failed to copy sync_clock to $HOST." >&2
    exit 1
  fi

  echo "Step 2/2: sudo on $HOST from ${ws_ip} (enter password if prompted)."
  ssh_tty "sudo env SYNC_CLOCK_WAIT_S=${WAIT_S} bash ${remote_tmp} ${remote_args[*]}; ec=\$?; rm -f ${remote_tmp}; exit \$ec"

  echo
  print_status
}

SOURCES_FILE="/etc/chrony/sources.d/pai-peer.sources"

follow_ip() {
  local ip="$1"
  if [[ ! "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "--ip needs an IPv4 address, got: ${ip}" >&2
    exit 1
  fi
  if ! command -v chronyd >/dev/null 2>&1; then
    echo "chronyd required for --follow" >&2
    exit 1
  fi

  mkdir -p /etc/chrony/sources.d
  cat >"$SOURCES_FILE" <<EOF
# Managed by scripts/sync_clock --follow
server ${ip} iburst prefer
EOF
  echo "Wrote ${SOURCES_FILE} -> server ${ip} iburst prefer"

  timedatectl set-ntp true || true
  systemctl enable --now chrony
  systemctl restart chrony
  sleep 1
  chronyc -a makestep || chronyc makestep || true

  echo "Waiting up to ${WAIT_S}s for |offset| <= 100 us (Ctrl-C to stop waiting) ..."
  local i sync leap offset offset_s
  for i in $(seq 1 "$WAIT_S"); do
    sync="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo no)"
    leap="$(chronyc tracking 2>/dev/null | awk -F': ' '/Leap status/ {print $2}')"
    offset="$(chronyc tracking 2>/dev/null | awk -F': ' '/System time/ {print $2}')"
    offset_s="$(awk '{print $1}' <<<"${offset:-}")"
    printf '[%3ds] synchronized=%-3s  leap=%-16s  %s\n' "$i" "$sync" "${leap:-?}" "${offset:-}"
    if [[ "$sync" == "yes" && "$leap" == "Normal" && -n "$offset_s" ]] \
      && awk -v o="$offset_s" 'BEGIN { o = (o < 0 ? -o : o); exit !(o <= 0.0001) }'; then
      echo "Converged (|offset| <= 100 us)."
      break
    fi
    sleep 1
  done

  echo
  chronyc -n sources -v || true
  echo
  chronyc tracking || true
  echo
  timedatectl | sed -n '1,8p' || true
  echo
  echo "chrony left RUNNING against ${ip}. Verify from workstation:"
  echo "  scripts/sync_clock --status"
}

oneshot_ip() {
  local ip="$1"
  if [[ ! "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "--ip needs an IPv4 address, got: ${ip}" >&2
    exit 1
  fi
  timedatectl set-ntp false || true
  echo "One-shot NTP sync from ${ip} ..."
  if command -v chronyd >/dev/null 2>&1; then
    chronyd -q "server ${ip} iburst"
  elif command -v ntpdate >/dev/null 2>&1; then
    ntpdate -u "$ip"
  else
    echo "Need chronyd or ntpdate on this host." >&2
    exit 1
  fi
  if command -v hwclock >/dev/null 2>&1; then
    hwclock -w || true
  fi
  echo
  date -u
  timedatectl | sed -n '1,8p' || true
  echo
  echo "NTP left disabled. Workstation: scripts/sync_clock --status"
}

run_local_privileged() {
  if [[ "$(id -u)" -ne 0 ]]; then
    echo "Re-exec with sudo ..."
    exec sudo -- "$SCRIPT_PATH" "$@"
  fi
}

case "$MODE" in
  status)
    print_status
    ;;
  serve)
    serve_lan
    ;;
  setup)
    apply_remote
    ;;
  apply)
    apply_remote
    ;;
  ip)
    if [[ "$ONESHOT" -eq 1 && "$FOLLOW" -eq 1 ]]; then
      echo "Use only one of --follow / --oneshot." >&2
      exit 1
    fi
    if [[ "$FOLLOW" -eq 1 ]]; then
      run_local_privileged --ip "$VALUE" --follow
      follow_ip "$VALUE"
    else
      run_local_privileged --ip "$VALUE"
      oneshot_ip "$VALUE"
    fi
    ;;
  utc)
    if [[ "$FOLLOW" -eq 1 ]]; then
      echo "--follow only applies with --ip / --apply." >&2
      exit 1
    fi
    run_local_privileged --utc "$VALUE"
    timedatectl set-ntp false || true
    echo "Setting UTC to: ${VALUE}"
    date -u -s "${VALUE}"
    if command -v hwclock >/dev/null 2>&1; then
      hwclock -w || true
    fi
    date -u
    timedatectl | sed -n '1,8p' || true
    ;;
esac
