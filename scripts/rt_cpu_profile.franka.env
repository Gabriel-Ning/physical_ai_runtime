# Franka RT host — same NUC11 i9-11900KB class.
# HT pairs: (0,8) (1,9) (2,10) (3,11) (4,12) (5,13) (6,14) (7,15)
#
# Isolate physical cores 6 and 7 only (both 5.0 GHz):
#   6,14  Franka FCI NIC IRQs
#   7,15  ros2_control / libfranka 1 kHz
# Do not isolcpus=12-15 — those are HT siblings of cores 4-7, not whole cores.
#
# NIC names are site-specific (beta). Edit if this host differs.
#   pixi run setup-rt franka
# Details: docs/FRANKA_RT_COMMUNICATION.md

RT_ISOL_CPUS=6,7,14,15
RT_CM_CPU_AFFINITY=7,15
RT_CPU_PROFILE_NAME=franka_single_isol4

RT_FRANKA_NIC=enp2s0
RT_FRANKA_IRQ_CPUS=6,14

RT_ROS_NIC=enp90s0
RT_ROS_IRQ_CPUS=0-5,8-13
