# Realtime CPU isolation profile for ros2_control on CPU / RT-kernel hosts.
# Sourced by:
#   - scripts/setup_cpu_rt_host.sh / apply_rt_isolcpus.sh
#   - .envrc when PIXI env is `cpu` (exports into the shell)
#   - Controller bringup launches (pins ros2_control_node via taskset)
#
# See docs/CPU_HOST_SETUP.md for full kernel tuning details.
#
# -----------------------------------------------------------------------------
# Workload Profiles / Examples:
# -----------------------------------------------------------------------------
#
# [Preset A] Marvin Bimanual + Dual Pika Grippers (8 isolated cores @ 500 Hz):
#   RT_ISOL_CPUS=7-10,12-15
#   RT_CM_CPU_AFFINITY=7-10,12-15
#   RT_CPU_PROFILE_NAME=marvin_pika_isol8
#
# [Preset B] Piper Bimanual Dual-Arm (8 isolated cores @ 500 Hz):
#   RT_ISOL_CPUS=7-10,12-15
#   RT_CM_CPU_AFFINITY=7-10,12-15
#   RT_CPU_PROFILE_NAME=piper_bimanual_isol8
#
# [Preset C] Franka FR3 Single-Arm on beta (see scripts/rt_cpu_profile.franka_beta.env):
#   RT_ISOL_CPUS=12-15
#   RT_CM_CPU_AFFINITY=14,15          # 1 kHz ros2_control / libfranka
#   RT_FRANKA_IRQ_CPUS=12,13         # Franka FCI NIC IRQs only
#   Apply on beta: sudo bash scripts/apply_franka_rt_host.sh && sudo reboot
#   Details: docs/FRANKA_RT_COMMUNICATION.md
#
# -----------------------------------------------------------------------------
# How to apply changes:
#   pixi run -e cpu setup  (writes GRUB cmdline) && sudo reboot
# -----------------------------------------------------------------------------

# Comma-separated CPU list for isolcpus / nohz_full / rcu_nocbs
RT_ISOL_CPUS=7-10,12-15

# controller_manager / ros2_control process affinity (same set by default)
RT_CM_CPU_AFFINITY=7-10,12-15

# Optional human label for logs and telemetry
RT_CPU_PROFILE_NAME=marvin_pika_isol8
