# Realtime CPU isolation profile for ros2_control on CPU / RT-kernel hosts.
# Sourced by:
#   - scripts/setup_cpu_rt_host.sh / apply_rt_isolcpus.sh
#   - .envrc when PIXI env is `cpu` (exports into the shell)
#   - Franka controller bringup (pins ros2_control_node via taskset)
#
# See docs/CPU_HOST_SETUP.md.
#
# Default: 2 isolated cores (baseline). If dual-arm OSQP @ 500 Hz shows
# sustained CM late under co-load, bump to four cores:
#   RT_ISOL_CPUS=12,13,14,15
#   RT_CM_CPU_AFFINITY=12,13,14,15
# then: pixi run -e cpu setup  (writes GRUB) && sudo reboot

# Comma-separated CPU list for isolcpus / nohz_full / rcu_nocbs
RT_ISOL_CPUS=14,15

# controller_manager / ros2_control process affinity (same set by default)
RT_CM_CPU_AFFINITY=14,15

# Optional human label for logs
RT_CPU_PROFILE_NAME=isol2_tail
