# Piper RT host — NUC11 i9-11900KB (8 cores / 16 threads).
# HT pairs: (0,8) (1,9) (2,10) (3,11) (4,12) (5,13) (6,14) (7,15)
#
# Isolate physical cores 4-7 as whole pairs (matches delta GRUB).
# Housekeeping: cores 0-3 → CPUs 0-3,8-11.
#
#   pixi run setup-rt piper

RT_ISOL_CPUS=4-7,12-15
RT_CM_CPU_AFFINITY=4-7,12-15
RT_CPU_PROFILE_NAME=piper_bimanual_isol8
