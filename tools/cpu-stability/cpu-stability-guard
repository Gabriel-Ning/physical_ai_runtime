#!/usr/bin/env bash
set -euo pipefail

PSTATE_DIR=/sys/devices/system/cpu/intel_pstate

write_setting() {
  local path=$1
  local value=$2

  if [[ -w "$path" ]]; then
    printf '%s\n' "$value" > "$path"
  else
    printf 'Cannot write %s (run as root)\n' "$path" >&2
    return 1
  fi
}

set_epp() {
  local value=$1
  local policy

  for policy in /sys/devices/system/cpu/cpufreq/policy*; do
    [[ -w "$policy/energy_performance_preference" ]] || continue
    printf '%s\n' "$value" > "$policy/energy_performance_preference"
  done
}

show_status() {
  local path

  for path in status min_perf_pct max_perf_pct no_turbo; do
    [[ -r "$PSTATE_DIR/$path" ]] || continue
    printf '%s=%s\n' "$path" "$(<"$PSTATE_DIR/$path")"
  done

  if command -v powerprofilesctl >/dev/null 2>&1; then
    printf 'power_profile=%s\n' "$(powerprofilesctl get 2>/dev/null || printf unknown)"
  fi

  if [[ -r /sys/devices/system/cpu/cpufreq/policy0/energy_performance_preference ]]; then
    printf 'energy_performance_preference=%s\n' \
      "$(</sys/devices/system/cpu/cpufreq/policy0/energy_performance_preference)"
  fi
}

apply_guard() {
  [[ -d "$PSTATE_DIR" ]] || {
    printf 'intel_pstate is not active; refusing to apply incompatible settings.\n' >&2
    exit 1
  }

  if command -v powerprofilesctl >/dev/null 2>&1; then
    powerprofilesctl set power-saver || true
  fi

  # Lower sustained demand and remove the high-voltage Turbo operating range.
  write_setting "$PSTATE_DIR/min_perf_pct" 15
  write_setting "$PSTATE_DIR/max_perf_pct" 80
  write_setting "$PSTATE_DIR/no_turbo" 1
  set_epp power
  show_status
}

rollback_guard() {
  [[ -d "$PSTATE_DIR" ]] || exit 0

  write_setting "$PSTATE_DIR/no_turbo" 0
  write_setting "$PSTATE_DIR/max_perf_pct" 100
  write_setting "$PSTATE_DIR/min_perf_pct" 15
  set_epp balance_performance

  if command -v powerprofilesctl >/dev/null 2>&1; then
    powerprofilesctl set balanced || true
  fi
  show_status
}

case "${1:-status}" in
  apply)
    apply_guard
    ;;
  rollback)
    rollback_guard
    ;;
  status)
    show_status
    ;;
  *)
    printf 'Usage: %s {apply|rollback|status}\n' "$0" >&2
    exit 2
    ;;
esac
