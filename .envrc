# Activate a locked Physical AI Runtime Pixi environment.
# Dependency updates are explicit; entering the directory never re-solves.
#
# Selection (first match):
#   1. PIXI_ENV=<name>          — explicit override
#   2. .pixi/environment        — written by `pixi run [-e …] setup`
#   3. default
#
# Environments:
#   default — full CPU robot runtime (workstation or RT host)
#   cuda13  — default runtime + CUDA 13 / CloudXR
#   lerobot — ROS-only base + LeRobot CUDA 12.8
#
# Workspace paths (CLOUDXR_DIR on cuda13, WORKSPACE_ROOT, RMW_IMPLEMENTATION)
# come from pixi.toml activation via shell-hook — do not re-export them here.
_pixi_env="${PIXI_ENV:-}"
if [ -z "$_pixi_env" ] && [ -f .pixi/environment ]; then
  _pixi_env="$(tr -d '[:space:]' < .pixi/environment)"
fi
if [ -z "$_pixi_env" ]; then
  _pixi_env=default
fi
export PIXI_FROZEN=true
eval "$(pixi shell-hook --frozen -e "$_pixi_env")"
if [ "$_pixi_env" = default ]; then
  unset CLOUDXR_DIR
fi

# RT host setup is independent of the dependency environment. `setup-rt`
# enables the workspace profile; PIXI_RT_PROFILE=1/0 explicitly overrides it.
_rt_profile_enabled="${PIXI_RT_PROFILE:-}"
if [ -z "$_rt_profile_enabled" ] && [ -f .pixi/rt-profile-enabled ]; then
  _rt_profile_enabled=1
fi
if { [ "$_pixi_env" = default ] || [ "$_pixi_env" = cuda13 ]; } && [ "$_rt_profile_enabled" = 1 ]; then
  # shellcheck disable=SC1091
  set -a
  . "$PWD/scripts/rt_cpu_profile.env"
  set +a
fi
unset _pixi_env _rt_profile_enabled

# Source the colcon overlay after at least one successful build.
if [ -f install/setup.bash ]; then
  source install/setup.bash
fi
