# Activate a locked Physical AI Runtime Pixi environment.
# Dependency updates are explicit; entering the directory never re-solves.
#
# Selection (first match):
#   1. PIXI_ENV=<name>          — explicit override
#   2. .pixi/environment        — written by `pixi run [-e …] setup`
#   3. only one of default/cpu/runtime installed under .pixi/envs/
#   4. else default             — previous cpu robot stack (no CUDA)
#
# Environments:
#   default / runtime — workstation robot stack (colcon, ros2_control, RMI)
#   cpu               — same packages + RT host isolcpus profile
#   curobo            — runtime + CUDA 13 / CloudXR
#   lerobot           — ROS-only base + LeRobot CUDA 12.8
#
# Workspace paths (CLOUDXR_DIR on curobo, WORKSPACE_ROOT, RMW_IMPLEMENTATION)
# come from pixi.toml activation via shell-hook — do not re-export them here.
_pixi_env="${PIXI_ENV:-}"
if [ -z "$_pixi_env" ] && [ -f .pixi/environment ]; then
  _pixi_env="$(tr -d '[:space:]' < .pixi/environment)"
fi
if [ -z "$_pixi_env" ]; then
  _installed=""
  for _cand in default runtime cpu; do
    if [ -d ".pixi/envs/${_cand}" ]; then
      _installed="${_installed} ${_cand}"
    fi
  done
  _installed="${_installed# }"
  case "$_installed" in
    *\ *) _pixi_env=default ;;
    "") _pixi_env=default ;;
    *) _pixi_env="${_installed}" ;;
  esac
  unset _cand _installed
fi
export PIXI_FROZEN=true
eval "$(pixi shell-hook --frozen -e "$_pixi_env")"
if [ "$_pixi_env" = default ] || [ "$_pixi_env" = runtime ] || [ "$_pixi_env" = cpu ]; then
  unset CLOUDXR_DIR
fi
if [ "$_pixi_env" = cpu ]; then
  # Realtime CPU profile: isolcpus list + ros2_control affinity for bringups.
  # shellcheck disable=SC1091
  set -a
  . "$PWD/scripts/rt_cpu_profile.env"
  set +a
fi
unset _pixi_env

# Source the colcon overlay after at least one successful build.
if [ -f install/setup.bash ]; then
  source install/setup.bash
fi
