# Activate a locked Physical AI Runtime Pixi environment.
# Dependency updates are explicit; entering the directory never re-solves.
#
# Selection (first match):
#   1. PIXI_ENV=<name>          — explicit override
#   2. .pixi/environment        — written by `pixi run [-e …] setup`
#   3. default
#
# This branch has one env: default = Piper RT CPU stack.
_pixi_env="${PIXI_ENV:-}"
if [ -z "$_pixi_env" ] && [ -f .pixi/environment ]; then
  _pixi_env="$(tr -d '[:space:]' < .pixi/environment)"
fi
if [ -z "$_pixi_env" ]; then
  _pixi_env=default
fi
export PIXI_FROZEN=true
eval "$(pixi shell-hook --frozen -e "$_pixi_env")"

# RT host setup is independent of the dependency environment. `setup-rt piper`
# enables the workspace profile; PIXI_RT_PROFILE=1/0 explicitly overrides it.
_rt_profile_enabled="${PIXI_RT_PROFILE:-}"
if [ -z "$_rt_profile_enabled" ] && [ -f .pixi/rt-profile-enabled ]; then
  _rt_profile_enabled=1
fi
if [ "$_rt_profile_enabled" = 1 ]; then
  _rt_name="$(tr -d '[:space:]' < .pixi/rt-profile 2>/dev/null || true)"
  if [ -z "$_rt_name" ]; then
    _rt_name=piper
  fi
  if [ -f "$PWD/scripts/rt_cpu_profile.${_rt_name}.env" ]; then
    # shellcheck disable=SC1090
    set -a
    . "$PWD/scripts/rt_cpu_profile.${_rt_name}.env"
    set +a
  fi
  unset _rt_name
fi
unset _pixi_env _rt_profile_enabled

if [ -f install/setup.bash ]; then
  source install/setup.bash
fi
