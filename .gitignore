# Pixi, direnv, and Python caches
.pixi/
.direnv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# ROS 2 / colcon artifacts
build/
install/
log/
output/
compile_commands.json

# Local virtual environments and environment overrides
.venv/
venv/
.env
.env.*
!.env.example

# Machine-local CycloneDDS instances live under .config/ next to the
# checked-in template. Track only cyclonedds_template.xml; ignore filled-in
# copies (e.g. cyclonedds_hik_host_192.168.10.100.xml).
.config/*
!.config/
!.config/cyclonedds_template.xml
!.config/cyclonedds_default.xml

# Runtime data and machine-local state
.cloudxr/*
!.cloudxr/.gitkeep
data/
recorded_episodes/
calibrations/
metrics/
MUJOCO_LOG.TXT

# Host-setup docs only. Design / architecture notes stay local, not this repo.
/docs/*
!/docs/CLOCK_SYNC.md
!/docs/CPU_HOST_SETUP.md
!/docs/UDEV_HOST_SETUP.md
!/docs/FRANKA_RT_COMMUNICATION.md

# Editor and operating-system noise
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Reference checkouts and repos
ref/
repos/
examples/
!/examples/
/examples/*
!/examples/README.md
!/examples/16_franka_gamepad_teleop.py

# ROS package checkouts under src/ are managed as independent repositories or Pixi binary packages.
# Keep structural placeholders so the workspace tree is present in git.
/src/controller/**
!/src/controller/.gitkeep

/src/execution/**
!/src/execution/.gitkeep

/src/interfaces/**
!/src/interfaces/.gitkeep

/src/motion_planning/**
!/src/motion_planning/.gitkeep

/src/recording/**
!/src/recording/.gitkeep

/src/teleop/**
!/src/teleop/.gitkeep

/src/toolbox/**
!/src/toolbox/.gitkeep
!/src/toolbox/dataset_tools/
!/src/toolbox/dataset_tools/**
!/src/toolbox/mjpeg_cam/
!/src/toolbox/mjpeg_cam/**

/src/visualization/**
!/src/visualization/.gitkeep

# Tracked source components
!/src/embodiments
!/src/interfaces/rmi/
!/src/interfaces/rmi/**
!/src/policy_inference/
!/src/policy_inference/**
!/src/rt_launch/
!/src/rt_launch/**
!/src/teleop/gamepad_teleop/
!/src/teleop/gamepad_teleop/**

# Never track Python bytecode or cache directories under src.
/src/**/__pycache__/
/src/**/.pytest_cache/
/src/**/*.py[cod]
/src/**/*.pyo
/src/**/*.pyd
