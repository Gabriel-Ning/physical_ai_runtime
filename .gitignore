# Pixi, direnv, and Python caches
.pixi/
.direnv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# ROS 2 / colcon artifacts
build/
install/
log/
output/
compile_commands.json

# Local virtual environments and environment overrides
.venv/
venv/
.env
.env.*
!.env.example

# Machine-local CycloneDDS instances live under .config/ next to the
# checked-in template. Track only cyclonedds_template.xml; ignore filled-in
# copies (e.g. cyclonedds_hik_host_192.168.10.100.xml).
.config/*
!.config/
!.config/cyclonedds_template.xml
!.config/cyclonedds_default.xml

# Runtime data and machine-local state
.cloudxr/*
!.cloudxr/.gitkeep
data/
recorded_episodes/
calibrations/
metrics/
MUJOCO_LOG.TXT

# Editor and operating-system noise
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Reference checkouts are development inputs, not runtime source packages.
ref/

# ROS package checkouts under src/ are managed as independent repositories.
# Keep structural placeholders so the workspace tree is present in git.
/src/**/
/src/**
!/src/
!/src/**/
!/src/**/.gitkeep
# Owned embodiment meta-repo gitlink. Nested package checkouts stay ignored.
!/src/embodiments
!/src/toolbox/
!/src/toolbox/**/
!/src/toolbox/**
!/src/policy_inference/
!/src/policy_inference/**/
!/src/policy_inference/**
!/src/embodiments/sensors/orbbec_camera_config/
!/src/embodiments/sensors/orbbec_camera_config/**/
!/src/embodiments/sensors/orbbec_camera_config/**
!/src/embodiments/sensors/realsense_camera_config/
!/src/embodiments/sensors/realsense_camera_config/**/
!/src/embodiments/sensors/realsense_camera_config/**
!/src/embodiments/sensors/usb_cam_camera_config/
!/src/embodiments/sensors/usb_cam_camera_config/**/
# Controller binaries come from Pixi. Track only the directory placeholder.
# Local checkouts, COLCON_IGNORE, and nested package gitkeeps stay untracked.
/src/controller/**
!/src/controller/.gitkeep
!/src/rt_launch/
!/src/rt_launch/**/
!/src/rt_launch/**
!/src/teleop/COLCON_IGNORE
# Never track Python bytecode or cache directories under src.
/src/**/__pycache__/
/src/**/.pytest_cache/
/src/**/*.py[cod]
/src/**/*.pyo
/src/**/*.pyd
