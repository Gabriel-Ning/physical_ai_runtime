# Pixi, direnv, and Python caches
.pixi/
.direnv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# ROS 2 / colcon artifacts
build/
install/
log/
output/
compile_commands.json

# Local virtual environments and environment overrides
.venv/
venv/
.env
.env.*
!.env.example

# Machine-local CycloneDDS instances live under .config/ next to the
# checked-in template. Track only cyclonedds_template.xml; ignore filled-in
# copies (e.g. cyclonedds_hik_host_192.168.10.100.xml).
.config/*
!.config/
!.config/cyclonedds_template.xml
!.config/cyclonedds_default.xml

# Runtime data and machine-local state
.cloudxr/*
!.cloudxr/.gitkeep
data/
recorded_episodes/
calibrations/
metrics/
MUJOCO_LOG.TXT

# Host-setup docs only. Design / architecture notes stay local, not this repo.
/docs/*
!/docs/CLOCK_SYNC.md
!/docs/CPU_HOST_SETUP.md
!/docs/UDEV_HOST_SETUP.md
!/docs/FRANKA_RT_COMMUNICATION.md
!/docs/SIM2REAL_EVALUATION_RUNTIME.md

# Editor and operating-system noise
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Reference checkouts and repos
ref/
repos/
examples/
!/examples/
/examples/*
!/examples/README.md
!/examples/16_franka_gamepad_teleop.py
!/examples/17_marvin_quest3_teleop.py
!/examples/18_marvin_joint_slider.py
!/examples/19_marvin_homing_replay.py
!/examples/20_marvin_trajectory_recording.py
!/examples/21_piper_leader_recording.py
!/examples/22_piper_joint_slider.py
!/examples/23_piper_homing_replay.py
!/examples/24_piper_trajectory_recording.py

# ROS package checkouts under src/ are managed as independent repositories or Pixi binary packages.
# Keep the maintained manipulation controller source alongside its published Pixi binary.
/src/controller/**
!/src/controller/.gitkeep
!/src/controller/manipulation_position_controllers/
!/src/controller/manipulation_position_controllers/**

/src/execution/**
!/src/execution/.gitkeep

/src/interfaces/**
!/src/interfaces/.gitkeep

/src/motion_planning/**
!/src/motion_planning/.gitkeep

/src/recording/**
!/src/recording/.gitkeep

/src/teleop/**
!/src/teleop/.gitkeep
!/src/teleop/gamepad_teleop/
!/src/teleop/gamepad_teleop/**
!/src/teleop/isaacteleop_toolbox/
!/src/teleop/isaacteleop_toolbox/**
!/src/teleop/piper_leader_teleop/
!/src/teleop/piper_leader_teleop/**

/src/toolbox/**
!/src/toolbox/.gitkeep
!/src/toolbox/dataset_tools/
!/src/toolbox/dataset_tools/**
!/src/toolbox/mjpeg_cam/
!/src/toolbox/mjpeg_cam/**

/src/visualization/**
!/src/visualization/.gitkeep

# Tracked source components
!/src/embodiments
!/src/interfaces/rmi/
!/src/interfaces/rmi/**
!/src/policy_inference/
!/src/policy_inference/**
!/src/rt_launch/
!/src/rt_launch/**
!/src/mujoco_ros2_control/
!/src/mujoco_ros2_control/**

# Keep task packages local for now (large assets + WIP); do not snapshot into pai.
/src/tasks/
/src/tasks/**

# Nested VCS metadata parked while snapshotting into this monorepo.
**/.git.pai_aside/
**/.git.pai_aside/**

# Never track Python bytecode or cache directories under src.
/src/**/__pycache__/
/src/**/.pytest_cache/
/src/**/*.py[cod]
/src/**/*.pyo
/src/**/*.pyd
**/.pai_upstream_remotes.txt
**/.pai_upstream_head.txt
